{
  "name": "dp-sanity-cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "prepare": "husky",
    "type-check": "tsc",
    "backup": "sanity dataset export production production.tar.gz --overwrite",
    "clearDevelopmentDataset": "sanity dataset delete development && sanity dataset create development --visibility public",
    "copyProdDataToDevelopment": "npm run backup && npm run clearDevelopmentDataset && sanity dataset import production.tar.gz development --replace",
    "check-updates": "ncu -i --format group"
  },
  "keywords": [
    "sanity"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --list-different",
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@navikt/aksel-icons": "^7.35.1",
    "@navikt/ds-css": "^7.35.1",
    "@navikt/ds-react": "^7.35.1",
    "@portabletext/react": "^5.0.0",
    "@sanity/document-internationalization": "^4.1.0",
    "@sanity/vision": "^4.20.3",
    "react": "^19.2.1",
    "react-animate-height": "^3.2.3",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-is": "^19.2.1",
    "sanity": "^4.20.3",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@sanity/eslint-config-studio": "^5.0.2",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
