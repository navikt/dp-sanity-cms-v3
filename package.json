{
  "name": "dp-sanity-cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "prepare": "husky install",
    "type-check": "tsc",
    "backup": "sanity dataset export production production.tar.gz --overwrite",
    "clearDevelopmentDataset": "sanity dataset delete development && sanity dataset create development --visibility public",
    "copyProdDataToDevelopment": "npm run backup && npm run clearDevelopmentDataset && sanity dataset import production.tar.gz development --replace",
    "check-updates": "ncu -i --format group"
  },
  "keywords": [
    "sanity"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --list-different",
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@navikt/ds-css": "^5.6.1",
    "@navikt/ds-icons": "^3.4.3",
    "@navikt/ds-react": "^5.6.1",
    "@portabletext/react": "^3.0.9",
    "@sanity/document-internationalization": "^1.0.4",
    "@sanity/vision": "^3.16.7",
    "husky": "^8.0.3",
    "lint-staged": "^14.0.1",
    "npm-check-updates": "^16.14.4",
    "react": "^18.2.0",
    "react-animate-height": "^3.2.2",
    "react-dom": "^18.2.0",
    "react-icons": "^4.11.0",
    "react-is": "^18.2.0",
    "sanity": "^3.16.7",
    "styled-components": "^5.3.11"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^3.0.1",
    "eslint": "^8.50.0",
    "prettier": "^2.8.8",
    "typescript": "^5.2.2"
  }
}
