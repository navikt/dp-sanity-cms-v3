{
  "name": "dp-sanity-cms",
  "private": true,
  "version": "1.0.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "prepare": "husky",
    "type-check": "tsc",
    "backup": "sanity dataset export production production.tar.gz --overwrite",
    "clearDevelopmentDataset": "sanity dataset delete development && sanity dataset create development --visibility public",
    "copyProdDataToDevelopment": "npm run backup && npm run clearDevelopmentDataset && sanity dataset import production.tar.gz development --replace",
    "check-updates": "ncu -i --format group"
  },
  "keywords": [
    "sanity"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --list-different",
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@navikt/ds-css": "^6.17.0",
    "@navikt/ds-icons": "^3.4.3",
    "@navikt/ds-react": "^6.17.0",
    "@portabletext/react": "^3.1.0",
    "@sanity/document-internationalization": "^3.1.0",
    "@sanity/vision": "^3.62.3",
    "react": "^18.3.1",
    "react-animate-height": "^3.2.3",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-is": "^18.3.1",
    "sanity": "^3.62.3",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^4.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "eslint": "^8.57.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
