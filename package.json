{
  "name": "dp-sanity-cms",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "package.json",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "prepare": "husky",
    "type-check": "tsc",
    "backup": "sanity dataset export production production.tar.gz --overwrite",
    "clearDevelopmentDataset": "sanity dataset delete development && sanity dataset create development --visibility public",
    "copyProdDataToDevelopment": "pnpm run backup && pnpm run clearDevelopmentDataset && sanity dataset import production.tar.gz development --replace",
    "check-updates": "ncu -i --format group"
  },
  "keywords": [
    "sanity"
  ],
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "singleQuote": true
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --list-different",
      "eslint --max-warnings 0"
    ]
  },
  "dependencies": {
    "@navikt/aksel-icons": "7.35.2",
    "@portabletext/react": "6.0.2",
    "@sanity/document-internationalization": "4.1.1",
    "@sanity/icons": "3.7.4",
    "@sanity/vision": "5.2.0",
    "classnames": "2.5.1",
    "react": "19.2.3",
    "react-animate-height": "3.2.3",
    "react-dom": "19.2.3",
    "react-icons": "5.5.0",
    "react-is": "19.2.3",
    "sanity": "5.2.0",
    "sanity-plugin-internationalized-array": "3.2.1",
    "styled-components": "6.1.19"
  },
  "devDependencies": {
    "@portabletext/types": "4.0.2",
    "@sanity/eslint-config-studio": "6.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "prettier": "3.7.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "prismjs": ">=1.30.0"
  },
  "pnpm": {
    "overrides": {
      "@portabletext/sanity-bridge": "2.0.0"
    }
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
